<div class="phone-container">

  <!-- الهيدر + الشريط المتحرك: ثابتين فوق ومش بينزلوا تحت مهما اتعمل سكرول -->
  <div class="ui-top">
    <header class="app-header">
      <div class="header-right">
        <div class="header-logo"><%- ic('comments') %></div>
        <div class="header-title">
          <h1>شات ودردشة ستوري</h1>
          <p>شات ستوري | شات السعودية</p>
        </div>
      </div>
      <div class="header-left">
        <button type="button" class="refresh-btn" onclick="location.reload()"><%- ic('rotate') %></button>
      </div>
    </header>

    <!-- الشريط المتحرك: النص بيبان من أول لحظة (من غير ما يستنى يدخل من برا الشاشة) — عدّل النص هنا -->
    <% /* [UIRETA-BADGES] نص الشريط من لوحة التحكم (الإضافات > Uireta > تغيير الشريط المتحرك) لكل دومين، والافتراضي لو فاضي */
       var __UI_TICK = (typeof uiticker !== 'undefined' && uiticker) ? uiticker : '✨ أهلاً بكم في شات ودردشة ستوري .. أول شات مدعوم بالذكاء الاصطناعي .. استمتع بالتواصل المجاني والآمن ✨'; %>
    <div class="ai-badge" role="marquee" aria-label="<%= __UI_TICK %>">
      <div class="ui-ticker"><div class="ui-ticker-track">
        <div class="ui-ticker-grp"><span><%= __UI_TICK %></span><span><%= __UI_TICK %></span><span><%= __UI_TICK %></span><span><%= __UI_TICK %></span></div>
        <div class="ui-ticker-grp" aria-hidden="true"><span><%= __UI_TICK %></span><span><%= __UI_TICK %></span><span><%= __UI_TICK %></span><span><%= __UI_TICK %></span></div>
      </div></div>
    </div>
  </div>

  <% if (typeof domainbanner !== 'undefined' && domainbanner) { %>
  <div class="ui-domain-banner" style="width:100%;line-height:0"><img src="<%= domainbanner %>" alt="" style="width:100%;height:auto;display:block"></div>
  <% } %>
  <!-- البانر -->
  <div class="hero-banner">
    <div class="shield-icon"><%- ic('shield-halved') %></div>
    <h2>شات ودردشة ستوري</h2>
    <p>دردشة تواصل، لقاء، مجاني وبدون تسجيل</p>
    <button type="button" class="join-btn" onclick="uiretaScrollToAuth()">انضم الآن!</button>
  </div>

  <!-- قسم التسجيل -->
  <div class="auth-section" id="uiAuthSection">
    <div class="tabs-container">
      <div class="tab active" onclick="uiretaTab('visitor')" id="uiTabVisitor"><%- ic('user-secret') %> دخول الزوار</div>
      <div class="tab" onclick="uiretaTab('member')" id="uiTabMember"><%- ic('user-lock') %> دخول الأعضاء</div>
      <div class="tab" onclick="uiretaTab('register')" id="uiTabRegister"><%- ic('user-plus') %> تسجيل</div>
      <div class="tab vip-tab" onclick="uiretaTab('vip')" id="uiTabVip"><%- ic('crown') %> اشتراك VIP</div>
    </div>

    <!-- صندوق مميزات العضوية الذهبية -->
    <div class="vip-features-box hidden" id="uiVipFeatures">
      <h3><%- ic('gem') %> مميزات العضوية الذهبية VIP:</h3>
      <ul>
        <li><%- ic('circle-check') %> تاج وهالة ذهبية مميزة لجوف اسمك وتثبيت في الأعلى.</li>
        <li><%- ic('circle-check') %> إمكانية إرسال الصور والفيديوهات والرسائل الصوتية.</li>
        <li><%- ic('circle-check') %> <b>كشف نكات</b> (معرفة الأسماء السابقة للمستخدمين).</li>
        <li><%- ic('circle-check') %> <b>حظر + طرد</b> (صلاحيات إدارية للتحكم بالغرفة).</li>
        <li><%- ic('circle-check') %> <b>تغيير البنر</b> (تخصيص بنر البروفايل والخلفيات).</li>
        <li><%- ic('circle-check') %> <b>إعطاء ومنح نقاط ولايكات</b> للأعضاء والمتواجدين.</li>
      </ul>
    </div>

    <form id="uiLoginForm" onsubmit="return uiretaSubmit(event)" autocomplete="off">
      <!-- حقل اسم الزوار (نفس id الأصلي u1 عشان باقي الشات يقراه) -->
      <div class="form-group" id="uiGroupVisitor">
        <div class="input-wrapper">
          <span class="input-icon"><%- ic('user') %></span>
          <input type="text" id="u1" placeholder="الاسم المستعار" value="عابر_سبيل">
          <button type="button" class="random-btn" onclick="uiretaRandomName()"><%- ic('dice') %> عشوائي</button>
        </div>
      </div>

      <!-- حقل اسم المستخدم للأعضاء والتسجيل -->
      <div class="form-group hidden" id="uiGroupUser">
        <div class="input-wrapper">
          <span class="input-icon"><%- ic('user-tag') %></span>
          <input type="text" id="uiUser" placeholder="اسم المستخدم">
        </div>
      </div>

      <!-- حقل كلمة المرور -->
      <div class="form-group hidden" id="uiGroupPass">
        <div class="input-wrapper">
          <span class="input-icon"><%- ic('lock') %></span>
          <input type="password" id="uiPass" placeholder="كلمة المرور">
          <button type="button" class="toggle-password" onclick="uiretaTogglePass('uiPass', this)"><%- ic('eye') %></button>
        </div>
      </div>

      <!-- حقل تأكيد كلمة المرور -->
      <div class="form-group hidden" id="uiGroupConfirm">
        <div class="input-wrapper">
          <span class="input-icon"><%- ic('lock-open') %></span>
          <input type="password" id="uiConfirm" placeholder="تأكيد كلمة المرور">
          <button type="button" class="toggle-password" onclick="uiretaTogglePass('uiConfirm', this)"><%- ic('eye') %></button>
        </div>
      </div>

      <!-- الحقول الأصلية اللي x2.js بيقرا منها (Login_) — مخفية -->
      <div class="ui-hidden-fields">
        <input type="hidden" id="u2"><input type="hidden" id="pass1">
        <input type="hidden" id="u3"><input type="hidden" id="pass2">
        <input type="checkbox" id="stealth">
      </div>

      <button type="submit" class="submit-btn" id="uiSubmitBtn">
        <span id="uiSubmitTxt">دخول سريع</span> <span id="uiSubmitIco"><%- ic('arrow-right-to-bracket') %></span>
      </button>
      <div class="label loginstat ui-stat ui-stat-blank"></div>
    </form>
  </div>

  <!-- شريط المتصلين (يحتوي على النقطة النابضة المطلوبة) -->
  <div class="online-bar">
    <div style="display: flex; align-items: center; gap: 8px;">
      <div class="pulse-container">
        <span class="pulse-ring"></span>
        <span class="online-status-dot"></span>
      </div>
      <span>المتصلين الآن</span>
    </div>
    <div class="online-count"><%- ic('users') %> <span><b class="s1" id="uiOnlineCount"><%= online %></b> متصل</span></div>
  </div>

  <!-- قائمة الأعضاء (نقاط ثابتة حسب الحالة: أخضر للمتصل، أحمر لغير المتصل) — بتتملي من uireta.js -->
  <div class="members-list" id="uiMembers"></div>

  <div class="app-footer"><%- namehost %></div>
  <%- include('sh-footer') %>
</div>
